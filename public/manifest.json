{
  "manifest_version": 3,
  "name": "NOVA \u2014 New Tab",
  "version": "0.1.0",
  "description": "A quieter, more intentional place to start your day.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "tabGroups",
    "sessions",
    "favicon",
    "sidePanel",
    "alarms"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "automation-worker.js"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "NOVA Web",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "optional_permissions": [
    "notifications"
  ],
  "commands": {
    "run-workflow": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Run the enabled NOVA shortcut workflow"
    }
  }
}
