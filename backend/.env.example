# Export these variables locally; never commit real values.
NOVA_SECRET_KEY=replace-with-a-long-random-django-secret
NOVA_DEBUG=1
NOVA_ALLOWED_HOSTS=127.0.0.1,localhost
# Set to chrome-extension://YOUR_UNPACKED_EXTENSION_ID
NOVA_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
NOVA_DAILY_LIMIT=30
NOVA_PROVIDER=openai
NOVA_PROVIDER_KEY=replace-with-server-side-provider-key
NOVA_PROVIDER_MODEL=gpt-4o-mini
